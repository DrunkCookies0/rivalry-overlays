{
  "name": "rivalry-overlay",
  "version": "0.6.11",
  "private": true,
  "description": "RIVALRY in-house Rocket League broadcast overlay. Bridges Rocket League's official Stats API into the browser and serves an OBS overlay + control panel. Ships as a Windows installer.",
  "main": "main.js",
  "author": "RIVALRY",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "start": "electron .",
    "mock": "electron . --mock",
    "test": "node --test",
    "verify:render": "node scripts/render-verify.js",
    "dev:bridge": "node bridge/rl-bridge.js --mock",
    "setup": "node bridge/rl-bridge.js --setup",
    "pack": "electron-builder --win --dir --config electron-builder.prod.js",
    "dist": "electron-builder --win --config electron-builder.prod.js",
    "dist:beta": "electron-builder --win --config electron-builder.beta.js",
    "release": "electron-builder --win --publish always --config electron-builder.prod.js",
    "overlay:keygen": "node tools/overlay-keys.js",
    "overlay:sign": "node tools/sign-overlay.js",
    "overlay:verify": "node tools/verify-overlay.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "obs-websocket-js": "^5.0.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3",
    "playwright": "^1.61.1"
  }
}
